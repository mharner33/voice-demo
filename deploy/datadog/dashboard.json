{
  "title": "Voice Demo \u2014 SIP/RTP to AI pipeline",
  "description": "One call's journey: packets in, jitter buffered, transcribed, answered, spoken. The left column is the network, the middle is the buffer's response to it, the right is what the AI layer made of the result. Read it left to right to see a lossy network become a less confident transcript.\n\nMetric names are asserted against internal/obs.MetricNames() by a test, so this dashboard cannot drift from the code.",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "default": "demo"
    },
    {
      "name": "provider_profile",
      "prefix": "provider_profile",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "network_profile",
      "prefix": "network_profile",
      "available_values": [],
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "**Network** \u2014 measured only from what arrived, exactly as a real gateway must. Trailing loss is invisible without an end-of-call packet count; see docs/plan.md.",
        "background_color": "blue",
        "font_size": "14",
        "text_align": "left",
        "vertical_align": "top",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "has_padding": true
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 1
      }
    },
    {
      "definition": {
        "title": "Estimated MOS (p50)",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "formulas": [
              {
                "formula": "query1"
              }
            ],
            "queries": [
              {
                "data_source": "metrics",
                "name": "query1",
                "query": "p50:voice.mos.estimate{$env,$provider_profile,$network_profile}"
              }
            ],
            "response_format": "scalar",
            "conditional_formats": [
              {
                "comparator": "<",
                "value": 2.5,
                "palette": "white_on_red"
              },
              {
                "comparator": "<",
                "value": 3.6,
                "palette": "white_on_yellow"
              },
              {
                "comparator": ">=",
                "value": 3.6,
                "palette": "white_on_green"
              }
            ]
          }
        ],
        "autoscale": false,
        "precision": 2
      },
      "layout": {
        "x": 0,
        "y": 1,
        "width": 3,
        "height": 2
      }
    },
    {
      "definition": {
        "title": "Packet loss %",
        "title_size": "16",
        "title_align": "left",
        "type": "timeseries",
        "requests": [
          {
            "formulas": [
              {
                "formula": "query1",
                "alias": "p50"
              },
              {
                "formula": "query2",
                "alias": "p95"
              }
            ],
            "queries": [
              {
                "data_source": "metrics",
                "name": "query1",
                "query": "p50:voice.rtp.loss_pct{$env,$provider_profile,$network_profile}"
              },
              {
                "data_source": "metrics",
                "name": "query2",
                "query": "p95:voice.rtp.loss_pct{$env,$provider_profile,$network_profile}"
              }
            ],
            "response_format": "timeseries",
            "style": {
              "palette": "warm",
              "line_type": "solid",
              "line_width": "normal"
            },
            "display_type": "line"
