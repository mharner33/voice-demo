# Copy to .env and fill in. .env is gitignored.

# ---- Datadog ----
# DD_API_KEY is required for the agent to forward anything.
DD_API_KEY=
# DD_APP_KEY is needed only for `make dashboard`.
DD_APP_KEY=
DD_SITE=datadoghq.com
DD_ENV=demo
DD_SERVICE=voicegw
DD_VERSION=0.1.0

# APM / DogStatsD endpoints as seen from inside the compose network
DD_AGENT_HOST=datadog-agent
DD_TRACE_AGENT_PORT=8126
DD_DOGSTATSD_PORT=8125

# Agent (LLM) Observability.
#
# In agent mode the tracer refuses to start unless a reachable agent supports
# LLM Obs, which is deliberate: an empty dashboard mid-demo is worse than a
# clear failure at launch. Set DD_LLMOBS_AGENTLESS_ENABLED=true to submit
# directly to Datadog instead, which needs DD_API_KEY in the app's own
# environment.
DD_LLMOBS_ENABLED=true
DD_LLMOBS_ML_APP=voice-demo
DD_LLMOBS_AGENTLESS_ENABLED=false

# Turn telemetry on in voicegw. Without this the gateway runs with no Datadog
# reporting at all, which is the default so the demo works with no agent.
VOICE_DD_ENABLED=true

# Call-log destination; "-" is stdout, which is what the container uses so the
# agent collects it from the container log stream.
VOICE_CALL_LOG=-

# ---- media ----
VOICE_RTP_PORT=5004
VOICE_GRPC_PORT=50051
VOICE_HTTP_PORT=8080

# ---- speech providers ----
#
# Recognition and synthesis are mocks by default, for the same reason the agent
# is: the mocks are a function of how much audio was consumed, so the same call
# transcribes identically every time and a change in the dashboards is a change
# in the network. The two are independent, so one stage can be real while the
# other stays fixed.
VOICE_REAL_STT=false
VOICE_REAL_TTS=false

# A project is required for both APIs, not just for billing: user credentials
# carry no project of their own and both services reject a request that does
# not name one to charge. A mounted service account carries its own.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Path inside the container. On a laptop, leave this unset and use
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project $GOOGLE_CLOUD_PROJECT
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json

# telephony is the Speech v2 model trained on 8 kHz phone audio. ("latest_long"
# is a v1 model name and is not valid here.)
VOICE_STT_MODEL=telephony
VOICE_STT_LANGUAGE=en-US

# The language must match the voice, or the service substitutes a different
# voice rather than failing.
VOICE_TTS_VOICE=en-US-Neural2-C
VOICE_TTS_LANGUAGE=en-US

# ---- the agent ----
#
# The mock agent is the default. It costs nothing, needs no credentials, and
# returns the same reply for the same transcript — which is what makes the
# transport story reproducible, since a change in the dashboards between runs
# is then a change in the network rather than in the model.
VOICE_REAL_LLM=false

# Model and reasoning effort for VOICE_REAL_LLM=true. Low effort is the default
# because the caller waits in silence for every token spent thinking; thinking
# is still left on, since disabling it risks the model writing a tool call into
# its spoken text instead of calling the tool.
VOICE_LLM_MODEL=claude-opus-5
VOICE_LLM_EFFORT=low

# Credentials for the real agent. The SDK also accepts a profile from
# `ant auth login`, in which case leave this empty.
ANTHROPIC_API_KEY=
