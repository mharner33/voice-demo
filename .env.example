# Copy to .env and fill in. .env is gitignored.

# ---- Datadog ----
# DD_API_KEY is required for the agent to forward anything.
DD_API_KEY=
# DD_APP_KEY is needed only for `make dashboard`.
DD_APP_KEY=
DD_SITE=datadoghq.com
DD_ENV=demo
DD_SERVICE=voicegw
DD_VERSION=0.1.0

# APM / DogStatsD endpoints as seen from inside the compose network
DD_AGENT_HOST=datadog-agent
DD_TRACE_AGENT_PORT=8126
DD_DOGSTATSD_PORT=8125

# Agent (LLM) Observability.
#
# In agent mode the tracer refuses to start unless a reachable agent supports
# LLM Obs, which is deliberate: an empty dashboard mid-demo is worse than a
# clear failure at launch. Set DD_LLMOBS_AGENTLESS_ENABLED=true to submit
# directly to Datadog instead, which needs DD_API_KEY in the app's own
# environment.
DD_LLMOBS_ENABLED=true
DD_LLMOBS_ML_APP=voice-demo
DD_LLMOBS_AGENTLESS_ENABLED=false

# Turn telemetry on in voicegw. Without this the gateway runs with no Datadog
# reporting at all, which is the default so the demo works with no agent.
VOICE_DD_ENABLED=true

# Call-log destination; "-" is stdout, which is what the container uses so the
# agent collects it from the container log stream.
VOICE_CALL_LOG=-

# ---- media ----
VOICE_RTP_PORT=5004
VOICE_GRPC_PORT=50051
VOICE_HTTP_PORT=8080

# ---- providers (phases 6-7; mock is the default) ----
VOICE_STT_PROVIDER=mock
VOICE_LLM_PROVIDER=mock
VOICE_TTS_PROVIDER=mock

# Google STT/TTS (phase 7) — path is inside the container
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json
GOOGLE_CLOUD_PROJECT=

# LLM (phase 6)
ANTHROPIC_API_KEY=
